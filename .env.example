# NexusMCP Environment Configuration

# Backend
ENV=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# MongoDB
MONGO_EXTERNAL_PORT=27018
MONGO_URI=mongodb://root:example@mongodb:27017/nexusmcp?authSource=admin
MONGO_DB_NAME=nexusmcp

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# PostgreSQL (for Temporal persistence)
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
POSTGRES_DB=temporal
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Security & Authentication
JWT_SECRET_KEY=nexusmcp-dev-secret-key-must-be-changed-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10
SECURE_COOKIES=false

# Composio Integration
COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=
COMPOSIO_BASE_URL=https://api.composio.dev
COMPOSIO_CALLBACK_URL=
COMPOSIO_ENTITY_TYPE=user
COMPOSIO_ENABLED_APPS=

# MCP Integration
MCP_ENABLED=false
MCP_ALLOWED_TRANSPORTS=stdio,http
MCP_DEFAULT_TIMEOUT_SECONDS=30
MCP_ALLOWED_STDIO_COMMANDS=npx,node,python,python3,uvx,pipx

# Frontend
VITE_API_URL=http://localhost:8000
